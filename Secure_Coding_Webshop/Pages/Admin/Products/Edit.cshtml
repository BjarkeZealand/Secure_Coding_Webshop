@page "{id:int?}"
@model Secure_Coding_Webshop.Pages.Admin.Products.EditModel
@{ ViewData["Title"] = Model.IsNew ? "Nyt produkt" : "Redigér produkt"; }

<h1>@ViewData["Title"]</h1>
<form method="post" enctype="multipart/form-data">
    <div asp-validation-summary="All"></div>
    <input type="hidden" asp-for="RowVersion" />
    <label>Navn <input asp-for="Input.Name" maxlength="150" required /></label>
    <label>Kategori
        <select asp-for="Input.CategoryId" asp-items="@(new SelectList(Model.Categories, "CategoryId", "Name"))"></select>
    </label>
    <label>Beskrivelse (ren tekst) <textarea asp-for="Input.Description" maxlength="2000" rows="6" required></textarea></label>
    <label>Pris (kr) <input asp-for="Input.Price" type="number" step="0.01" min="0.01" max="1000000" required /></label>
    <label>Lager <input asp-for="Input.StockQuantity" type="number" min="0" max="100000" required /></label>
    <label>Billede (JPEG, PNG eller WebP, max 2 MB) <input type="file" name="Image" accept="image/jpeg,image/png,image/webp" /></label>
    <button type="submit">Gem</button>
</form>

@* Indsæt i _Layout.cshtml i navigationen: <partial name="_LoginPartial" /> *@
@using Secure_Coding_Webshop.Services
<ul class="login-links">
    <li><a href="/Products">Produkter</a></li>
    <li><a href="/Cart">Kurv</a></li>
@if (User.Identity?.IsAuthenticated == true)
{
    <li><a href="/Account">@User.Identity.Name</a></li>
    <li><a href="/Orders">Mine ordrer</a></li>
    @if (User.IsInRole(RoleNames.Admin)) { <li><a href="/Admin/Products">Admin</a></li> }
    @if (User.IsInRole(RoleNames.SysAdmin)) { <li><a href="/SysAdmin/Logs">Logs</a></li> }
    <li>
        <form method="post" asp-page="/Account/Logout" class="inline">
            <button type="submit">Log ud</button>
        </form>
    </li>
}
else
{
    <li><a href="/Account/Login">Log ind</a></li>
    <li><a href="/Account/Register">Opret konto</a></li>
}
</ul>

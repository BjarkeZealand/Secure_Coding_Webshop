@page
@model Secure_Coding_Webshop.Pages.Account.ResetPasswordModel
@{ ViewData["Title"] = "Ny adgangskode"; }

<h1>Vælg ny adgangskode</h1>
@if (Model.Done)
{
    <p role="status">Din adgangskode er nulstillet. <a href="/Account/Login">Log ind</a></p>
}
else if (!Model.TokenValid)
{
    <p role="alert">Linket er ugyldigt eller udløbet. <a asp-page="ForgotPassword">Bed om et nyt</a></p>
}
else
{
    <form method="post" autocomplete="off">
        <div asp-validation-summary="All"></div>
        <input type="hidden" asp-for="Token" />
        <label>Ny adgangskode <input asp-for="NewPassword" id="new-password" type="password" autocomplete="new-password" minlength="12" maxlength="128" required /></label>
        <div id="password-meter" aria-live="polite"></div>
        <label>Gentag <input asp-for="Confirm" type="password" autocomplete="new-password" required /></label>
        @if (Model.NeedsMfa)
        {
            <label>Kode fra din authenticator-app (eller en backupkode) <input asp-for="MfaCode" autocomplete="one-time-code" maxlength="10" required /></label>
        }
        <button type="submit">Gem</button>
    </form>
    <script src="~/js/password-meter.js"></script>
}

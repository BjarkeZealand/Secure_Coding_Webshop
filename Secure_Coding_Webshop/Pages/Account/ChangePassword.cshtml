@page
@model Secure_Coding_Webshop.Pages.Account.ChangePasswordModel
@{ ViewData["Title"] = "Skift adgangskode"; }

<h1>Skift adgangskode</h1>
@if (Model.Done)
{
    <p role="status">Din adgangskode er ændret. Alle andre enheder er logget ud.</p>
}
else
{
    <form method="post" autocomplete="off">
        <div asp-validation-summary="All"></div>
        <label>Nuværende adgangskode <input asp-for="Input.Current" type="password" autocomplete="current-password" required /></label>
        <label>Ny adgangskode <input asp-for="Input.New" id="new-password" type="password" autocomplete="new-password" minlength="12" maxlength="128" required /></label>
        <div id="password-meter" aria-live="polite"></div>
        <label>Gentag ny adgangskode <input asp-for="Input.Confirm" type="password" autocomplete="new-password" required /></label>
        <button type="submit">Skift adgangskode</button>
    </form>
    <p><button type="button" id="generate-passphrase">Foreslå en adgangskode</button> <output id="passphrase-output"></output></p>
    <script src="~/js/password-meter.js"></script>
}

@page
@model Secure_Coding_Webshop.Pages.Account.ForgotPasswordModel
@{ ViewData["Title"] = "Glemt adgangskode"; }

<h1>Glemt adgangskode</h1>
@if (Model.Sent)
{
    @* Samme tekst uanset om kontoen findes: ingen konto-enumeration *@
    <p role="status">Hvis e-mailadressen er oprettet hos os, har vi sendt et link til at vælge en ny adgangskode.</p>
}
else
{
    <form method="post">
        <label>E-mail <input asp-for="Email" type="email" maxlength="254" autocomplete="email" required /></label>
        <button type="submit">Send link</button>
    </form>
}

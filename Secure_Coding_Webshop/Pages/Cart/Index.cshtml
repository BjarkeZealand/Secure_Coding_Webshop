@page
@model Secure_Coding_Webshop.Pages.Cart.IndexModel
@{ ViewData["Title"] = "Kurv"; }

<h1>Din kurv</h1>
@if (Model.Message is not null) { <p role="status">@Model.Message</p> }

@if (Model.Lines.Count == 0)
{
    <p>Kurven er tom. <a href="/Products">Se produkter</a></p>
}
else
{
    <table>
        <thead><tr><th>Produkt</th><th>Pris</th><th>Antal</th><th>I alt</th><th></th></tr></thead>
        <tbody>
        @foreach (var l in Model.Lines)
        {
            <tr>
                <td>@l.Name @if (!l.IsActive || l.StockQuantity < l.Quantity) { <em>(ikke tilgængelig i dette antal)</em> }</td>
                <td>@l.UnitPrice.ToString("N2") kr</td>
                <td>
                    <form method="post" asp-page-handler="Update">
                        <input type="hidden" name="productId" value="@l.ProductId" />
                        <input type="number" name="quantity" value="@l.Quantity" min="0" max="99" aria-label="Antal" />
                        <button type="submit">Opdatér</button>
                    </form>
                </td>
                <td>@l.LineTotal.ToString("N2") kr</td>
                <td>
                    <form method="post" asp-page-handler="Remove">
                        <input type="hidden" name="productId" value="@l.ProductId" />
                        <button type="submit">Fjern</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
        <tfoot><tr><th colspan="3">Total</th><th>@Model.Total.ToString("N2") kr</th><th></th></tr></tfoot>
    </table>
    <p><a href="/Checkout">Gå til kassen</a></p>
}
